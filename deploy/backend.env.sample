# WSL/RPi local file. Copy to /etc/hestia/backend.env and fill secrets there.
# Never commit the copied backend.env file.

MQTT_HOST=localhost
MQTT_PORT=1883
HESTIA_MQTT_ENABLED=1
HESTIA_SRC_ID=rpi5-api
HESTIA_DB_PATH=/data/hestia/backend/hestia.db

# Telegram caregiver channel
HESTIA_TELEGRAM_ENABLED=1
HESTIA_TELEGRAM_BOT_TOKEN=replace_with_botfather_token
HESTIA_TELEGRAM_CHAT_ID=replace_with_caregiver_chat_id
HESTIA_TELEGRAM_TIMEOUT_SEC=10

# Sunday 18:00 (local machine time)
HESTIA_TELEGRAM_WEEKLY_ENABLED=1
HESTIA_TELEGRAM_WEEKLY_WEEKDAY=6
HESTIA_TELEGRAM_WEEKLY_HOUR=18
HESTIA_TELEGRAM_WEEKLY_MINUTE=0
